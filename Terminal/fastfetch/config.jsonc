{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "kitty-direct",
    "source": "/home/kali/.config/fastfetch/assets/jedi.png",

    "width": 26,
    "height": 18,

    "padding": {
      "top": 0,
      "left": 4
    },

    "preserveAspectRatio": false
  },


  "modules": [
    "break",

    {
      "type": "custom",
      "format": "╭─➤  HARDWARE ⮜─────────────────────────────────────────────╮",
      "outputColor": "36"
    },
    {
      "type": "custom",
      "format": "╰─┬──────────────────────────────────────────────────────────╯",
      "outputColor": "36"
    },

    {
      "type": "chassis",
      "key": "  ├ ",
      "keyColor": "36",
      "outputColor": "38;5;208"
    },
    {
      "type": "cpu",
      "key": "  ├ ",
      "keyColor": "36",
      "outputColor": "38;5;208"
    },
    {
      "type": "gpu",
      "key": "  ├ ",
      "keyColor": "36",
      "outputColor": "38;5;208"
    },
    {
      "type": "memory",
      "key": "  ├ ",
      "keyColor": "36",
      "outputColor": "38;5;208"
    },
    {
      "type": "disk",
      "key": "  ├ ",
      "keyColor": "36",
      "outputColor": "38;5;208"
    },
    {
      "type": "display",
      "key": "  ├ ",
      "keyColor": "36",
      "outputColor": "38;5;208"
    },
    {
      "type": "battery",
      "key": "  ├ ",
      "keyColor": "36",
      "outputColor": "38;5;208"
    },

    {
      "type": "custom",
      "format": "  ╰──────────────────────────────────────────────────────────╯",
      "outputColor": "36"
    },

    "break",

    {
      "type": "custom",
      "format": "╭─➤  SOFTWARE ⮜─────────────────────────────────────────────╮",
      "outputColor": "38;5;208"
    },
    {
      "type": "custom",
      "format": "╰─┬──────────────────────────────────────────────────────────╯",
      "outputColor": "38;5;208"
    },

    {
      "type": "os",
      "key": "  ├ ",
      "keyColor": "38;5;208",
      "outputColor": "36"
    },
    {
      "type": "kernel",
      "key": "  ├ ",
      "keyColor": "38;5;208",
      "outputColor": "36"
    },
    {
      "type": "shell",
      "key": "  ├ ",
      "keyColor": "38;5;208",
      "outputColor": "36"
    },
    {

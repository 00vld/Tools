      "key": "  ├ ",
      "keyColor": "38;5;208",
      "outputColor": "36"
    },
    {
      "type": "terminal",
      "key": "  ├ ",
      "keyColor": "38;5;208",
      "outputColor": "36"
    },
    {
      "type": "wm",
      "key": "  ├ ",
      "keyColor": "38;5;208",
      "outputColor": "36"
    },
    {
      "type": "de",
      "key": "  ├ ",
